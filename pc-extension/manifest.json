{
  "manifest_version": 3,
  "name": "FormPilot",
  "version": "0.1.0",
  "description": "Fill supported Google Forms from a local answer profile. Review and submit yourself.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://docs.google.com/forms/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FormPilot"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
